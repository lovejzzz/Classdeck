# AI 助教连接器需要。不填的话其他连接器照常工作，AI 助教显示“未配置”。
ANTHROPIC_API_KEY=

# 可选：换一个模型。默认 claude-opus-5-5。
# LMS_AI_MODEL=claude-opus-5-5

# 自定义连接器的密钥必须以 LMS_ 开头，例如：
# LMS_MY_API_KEY=

# —— 上线时需要 ——
# 网站的公开地址。邀请链接、二维码、导出文件里的链接都用它。
# PUBLIC_URL=https://questhand.com

# Cloudflare R2：学生上传的视频、录音、图片、文件都存在这里（浏览器直接上传，不经过服务器）。
# 四项都填了才会启用；不填的话文件存在本机 .data/uploads（开发时就是这样）。
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=questhand

# 上传上限（MB）。默认：单个文件 200，每个学生 500，每位老师 5000，示范课访客合计 500。
# UPLOAD_MAX_FILE_MB=200
# UPLOAD_STUDENT_MB=500
# UPLOAD_TEACHER_MB=5000
# UPLOAD_DEMO_MB=500
